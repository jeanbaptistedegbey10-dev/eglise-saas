# ---------------------------------------------------------------------------
# Fichier d'exemple des variables d'environnement — copier vers `.env`.
# ---------------------------------------------------------------------------

# Base de données PostgreSQL (Prisma 7 + driver adapter pg).
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# --- Authentification (Auth.js / NextAuth v5) -------------------------------
# Secret de signature des sessions et des jetons (obligatoire en production).
# Génération : `openssl rand -base64 32`
AUTH_SECRET=""
# URL publique de l'application (redirections après connexion).
AUTH_URL="http://localhost:3000"
# Durée de session en secondes (30 jours par défaut).
AUTH_SESSION_MAX_AGE="2592000"

# --- Brevo (ex Sendinblue) — e-mails transactionnels (SMTP / Nodemailer) -----
# Relais SMTP : smtp-relay.brevo.com, port 587 (STARTTLS).
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
# Login SMTP (Brevo > Paramètres SMTP — souvent l'e-mail du compte).
BREVO_SMTP_LOGIN=""
# Clé SMTP Brevo ; BREVO_API_KEY acceptée en repli.
BREVO_SMTP_KEY=""
BREVO_API_KEY=""
# Expéditeur affiché — doit être vérifié dans Brevo.
BREVO_EXPEDITEUR_NOM="Église SaaS"
BREVO_EXPEDITEUR_EMAIL=""

# --- Outils de démonstration (production) ------------------------------------
# Injection / purge des données démo (`src/actions/demo-data.ts`).
# En production, les outils sont REFUSÉS sauf activation explicite.
ACTIVER_OUTILS_DEMO="false"